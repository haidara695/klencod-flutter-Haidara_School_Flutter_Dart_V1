rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(schoolId) {
      return signedIn() && exists(/databases/$(database)/documents/memberships/$(schoolId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/memberships/$(schoolId + '_' + request.auth.uid)).data.active == true;
    }
    function role(schoolId) {
      return get(/databases/$(database)/documents/memberships/$(schoolId + '_' + request.auth.uid)).data.role;
    }
    function manager(schoolId) { return member(schoolId) && role(schoolId) in ['owner', 'manager', 'admin']; }
    function editor(schoolId) { return member(schoolId) && role(schoolId) in ['owner', 'manager', 'admin', 'teacher', 'attendance']; }
    match /memberships/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false; // trusted admin provisioning only
    }
    match /schools/{schoolId} {
      allow read: if member(schoolId);
      allow write: if false;
      match /years/{yearId} {
        allow read: if member(schoolId);
        allow create: if manager(schoolId) && request.resource.data.keys().hasOnly(['name','createdAt']);
        allow update, delete: if false;
        match /classes/{classId} {
          allow read: if member(schoolId);
          allow create: if manager(schoolId) && request.resource.data.keys().hasOnly(['name','createdAt']);
          allow update, delete: if false;
        }
        match /students/{studentId} {
          allow read: if member(schoolId);
          allow create: if manager(schoolId) && request.resource.data.keys().hasOnly(['name','phone','classId','createdAt']);
          allow update: if manager(schoolId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','classId']);
          allow delete: if false;
        }
        match /attendance/{attendanceId} {
          allow read: if member(schoolId);
          allow create, update: if editor(schoolId)
            && request.resource.data.keys().hasOnly(['date','classId','studentId','status','updatedBy','updatedAt'])
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.status in ['حاضر','غائب','متأخر','مستأذن']
            && request.resource.data.updatedAt == request.time
            && attendanceId == request.resource.data.date + '_' + request.resource.data.studentId
            && exists(/databases/$(database)/documents/schools/$(schoolId)/years/$(yearId)/students/$(request.resource.data.studentId))
            && get(/databases/$(database)/documents/schools/$(schoolId)/years/$(yearId)/students/$(request.resource.data.studentId)).data.classId == request.resource.data.classId;
          allow delete: if false;
        }
      }
    }
  }
}
